{
  "name": "og",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write . && bun run lint --fix",
    "icon": "bun scripts/icon.ts",
    "setup": "bun scripts/setup.ts",
    "emoji": "bun scripts/emoji.ts",
    "world-map": "bun scripts/worldMap.ts",
    "check:scripts": "svelte-kit sync && tsc -p scripts/tsconfig.json",
    "ci": "biome format . && bun run lint && bun run check && bun run check:scripts && bun run test && bun run build",
    "bump": "bun scripts/bump.ts",
    "verify": "bash scripts/verify.sh",
    "land": "bash scripts/land.sh",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-cloudflare": "7.2.9",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.3",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "msw": "2.15.0",
    "opentype.js": "2.0.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.143.0"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@trakt/api": "npm:@jsr/trakt__api@0.7.14",
    "oidc-client-ts": "3.5.0",
    "zod": "3.25.76"
  }
}
