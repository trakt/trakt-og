{
  "name": "og",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "biome format --write . && bun run lint --fix",
    "icon": "bun scripts/icon.ts",
    "setup": "bun scripts/setup.ts",
    "emoji": "bun scripts/emoji.ts",
    "world-map": "bun scripts/worldMap.ts",
    "seo:check": "bun scripts/seo-check.ts",
    "check:scripts": "svelte-kit sync && tsc -p scripts/tsconfig.json",
    "ci": "biome format . && bun run lint && bun run check && bun run check:scripts && bun run test && bun run build",
    "bump": "bun scripts/bump.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@sveltejs/adapter-cloudflare": "8.0.2",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "lightningcss": "1.33.0",
    "msw": "3.0.4",
    "opentype.js": "2.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "dependencies": {
    "@tiptap/core": "3.33.0",
    "@tiptap/extensions": "3.33.0",
    "@tiptap/pm": "3.33.0",
    "@tiptap/starter-kit": "3.33.0",
    "@trakt/api": "npm:@jsr/trakt__api@0.7.17",
    "oidc-client-ts": "3.5.0",
    "zod": "3.25.76"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
