{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trakt-og",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  // Served only on og.trakt.tv. wrangler deploy creates the DNS record and cert (same pattern as the auth worker).
  "routes": [{ "pattern": "og.trakt.tv", "custom_domain": true }],
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  // The live page's one refresher for the whole world (src/lib/live/WatchingNowLive.ts). vite.config.ts exports the
  // class from the built worker, since SvelteKit's adapter doesn't.
  "durable_objects": {
    "bindings": [{ "name": "WATCHING_NOW_LIVE", "class_name": "WatchingNowLive" }]
  },
  "migrations": [{ "tag": "watching-now-live", "new_sqlite_classes": ["WatchingNowLive"] }]
}
